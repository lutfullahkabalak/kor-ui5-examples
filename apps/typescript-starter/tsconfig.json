{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "types": [
      "@openui5/ts-types-esm",
      "kor-ui5"
    ],
    "baseUrl": ".",
    "paths": {
      "kor/example/typescriptstarter/*": [
        "./webapp/*"
      ]
    }
  },
  "include": [
    "webapp/**/*"
  ]
}
